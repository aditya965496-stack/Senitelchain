# ===============================================
# SentinelChain Enterprise Environment Variables
# ===============================================

# Network Configuration (Polygon Amoy Testnet)
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_RPC_URL=https://polygon-amoy.drpc.org
NEXT_PUBLIC_EXPLORER_URL=https://amoy.polygonscan.com

# Deployed Smart Contract Registry Address (Paste your deployed SentinelAuditRegistry address)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# IPFS Pinata Service (Optional: Set your Pinata JWT for real cluster pinning)
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY_URL=https://gateway.pinata.cloud

# Deployment Private Key (for deploy.js script only - keep strictly secret)
PRIVATE_KEY=your_polygon_amoy_private_key_here
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
